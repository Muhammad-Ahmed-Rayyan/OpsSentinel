# Which provider to use: openrouter or groq
LLM_PROVIDER=openrouter

# OpenRouter
OPENROUTER_API_KEY=your_key_here
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# Groq
GROQ_API_KEY=your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: a Slack-compatible incoming webhook for approval, review and escalation
# notifications. Leave empty to write notifications to the notifications folder only.
SLACK_WEBHOOK_URL=